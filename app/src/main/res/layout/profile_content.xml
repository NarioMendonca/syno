<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B10">

    <!-- Conteúdo -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- Foto do perfil -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_profile"
                    android:contentDescription="Foto de perfil"
                    android:tint="#FFFFFF"
                    />

                <!-- Indicador online -->

                <View
                    android:id="@+id/onlineIndicator"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:translationX="42dp"
                    android:translationY="42dp"
                    android:background="@drawable/online_indicator" />

            </FrameLayout>


            <!-- Nome -->

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="João Silva"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />


            <!-- Status -->

            <TextView
                android:id="@+id/tvOnlineStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="● Online"
                android:textColor="#22C55E"
                android:textSize="13sp" />


            <!-- Descrição -->

            <TextView
                android:id="@+id/tvProfileDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Gosto de jogar com a galera e conhecer novos jogadores."
                android:textColor="#A1A1AA"
                android:textSize="14sp" />


            <!-- Informações -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#17171F">

                <TextView
                    android:id="@+id/tvFavoriteGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎮 Jogo favorito: "
                    android:textColor="#D4D4D8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📍 "
                    android:textColor="#D4D4D8"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- Divisor -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#27272A" />


            <!-- Avaliação -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Avaliação"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="#17171F">

                <!-- Nota atual -->

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.7"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Estrelas atuais -->

                <TextView
                    android:id="@+id/tvRatingStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="★★★★★"
                    android:textColor="#FBBF24"
                    android:textSize="20sp" />

                <!-- Quantidade -->

                <TextView
                    android:id="@+id/tvVotesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="32 avaliações"
                    android:textColor="#71717A"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- Avaliar -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Avalie este jogador"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- Seleção de nota -->

            <LinearLayout
                android:id="@+id/ratingSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/star1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#71717A"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/star2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#71717A"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/star3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#71717A"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/star4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#71717A"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/star5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#71717A"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <Button
                android:id="@+id/btnSubmitRating"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#8B5CF6"
                android:text="Enviar avaliação"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- Divisor -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="#27272A" />


            <!-- Comentários -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Comentários"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCommentsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#71717A"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- Lista de comentários -->

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />


            <!-- Campo para novo comentário -->

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="90dp"
                android:gravity="top|start"
                android:hint="Escreva um comentário..."
                android:padding="14dp"
                android:background="#17171F"
                android:textColor="#FFFFFF"
                android:textColorHint="#71717A"
                android:textSize="14sp" />


            <Button
                android:id="@+id/btnSubmitComment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#27272A"
                android:text="Publicar comentário"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>