<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#17171F">

    <!-- Cabeçalho -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvDetailsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detalhes da partida"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseDetails"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Fechar"
            android:background="@drawable/button_icon_ripple"
            android:src="@drawable/ic_close"
            android:tint="#A1A1AA" />

    </LinearLayout>


    <!-- Conteúdo rolável -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="600dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">


            <!-- Jogo -->

            <TextView
                android:id="@+id/tvDetailsGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Valorant"
                android:textColor="#A78BFA"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- Nome -->

            <TextView
                android:id="@+id/tvDetailsMatchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ranked com a galera"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- Data -->

            <TextView
                android:id="@+id/tvDetailsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="📅 24/08/2026 • 19:30"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />


            <!-- Jogadores -->

            <TextView
                android:id="@+id/tvDetailsPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="👥 3 / 5 jogadores"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />


            <!-- Tipo -->

            <TextView
                android:id="@+id/tvDetailsGameType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="🎮 Competitivo"
                android:textColor="#D4D4D8"
                android:textSize="14sp"
                android:visibility="gone" />


            <!-- Local -->

            <TextView
                android:id="@+id/tvDetailsLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="🔗 Discord"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />


            <!-- Idade média -->

            <TextView
                android:id="@+id/tvDetailsAverageAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="👤 Idade média: 20 anos"
                android:textColor="#D4D4D8"
                android:textSize="14sp"
                android:visibility="gone" />


            <!-- Divisor -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#27272A" />


            <!-- Participantes -->

            <TextView
                android:id="@+id/tvParticipantsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Participantes"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvParticipantsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="3 jogadores"
                android:textColor="#71717A"
                android:textSize="13sp" />


            <!-- Lista de usuários -->

            <LinearLayout
                android:id="@+id/participantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />


            <!-- Botão -->

            <Button
                android:id="@+id/btnJoinMatch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#8B5CF6"
                android:text="Participar da partida"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>