<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10">


    <!-- ===================================================== -->
    <!-- ESTADO 1 - CONFIGURAÇÃO DA BUSCA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/searchConfigContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">


        <!-- Cabeçalho -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_icon_ripple"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Buscar jogador"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Conteúdo -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="30dp">


                <!-- Explicação -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔎"
                        android:textSize="52sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Encontre um jogador perto de você"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="O Syno procurará jogadores na sua região que estejam disponíveis para conhecer novos jogadores."
                        android:textColor="#71717A"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>


                <!-- Contato -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Seu contato"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContact"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Ex: link de amizade do Discord"
                    android:inputType="textUri"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#17171F"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />


                <!-- Visibilidade -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ficar visível para jogadores"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Seu perfil poderá ser encontrado por jogadores da sua região durante 1 dia."
                            android:textColor="#71717A"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchVisible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                </LinearLayout>


                <!-- Raio -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Raio de busca"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 km"
                        android:textColor="#71717A"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seekBarDistance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:max="49"
                        android:progress="4"
                        android:progressTint="#8B5CF6"
                        android:thumbTint="#A78BFA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 km"
                        android:textColor="#71717A"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDistanceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="5 km"
                    android:textColor="#A78BFA"
                    android:textSize="18sp"
                    android:textStyle="bold" />


                <!-- Buscar -->

                <Button
                    android:id="@+id/btnSearchPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#8B5CF6"
                    android:text="Buscar jogador"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ESTADO 2 - PROCURANDO -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/searchingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivSearchingIcon"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:src="@drawable/ic_search"
            android:tint="#A78BFA"
            android:contentDescription="Procurando" />

        <TextView
            android:id="@+id/tvSearching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Procurando jogador..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estamos procurando alguém próximo a você."
            android:textColor="#71717A"
            android:textSize="13sp" />

        <ProgressBar
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#8B5CF6" />

        <Button
            android:id="@+id/btnCancelSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="#27272A"
            android:text="Cancelar busca"
            android:textAllCaps="false"
            android:textColor="#F87171"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ESTADO 3 - JOGADOR ENCONTRADO -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/playerFoundContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBackFound"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_icon_ripple"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Jogador encontrado"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="30dp">

            <ImageView
                android:id="@+id/ivFoundPlayerPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_profile"
                android:contentDescription="Foto do jogador" />

            <TextView
                android:id="@+id/tvFoundPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="João Silva"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🟢 Jogador encontrado"
                android:textColor="#22C55E"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#17171F">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contato"
                    android:textColor="#71717A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFoundPlayerContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="discord.com/users/..."
                    android:textColor="#A78BFA"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvFoundPlayerDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📍 3,2 km de distância"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ESTADO 4 - NENHUM JOGADOR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/noPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔎"
            android:textSize="55sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nenhum jogador encontrado"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:text="Não encontramos jogadores disponíveis dentro do raio escolhido."
            android:textColor="#71717A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTryAgain"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#8B5CF6"
            android:text="Tentar novamente"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ESTADO 5 - USUÁRIO ESTÁ VISÍVEL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/visibleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">


        <!-- Cabeçalho -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBackVisible"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_icon_ripple"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Buscar jogador"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Conteúdo -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">


            <!-- Ícone -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="58sp" />


            <!-- Título -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Você está visível!"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />


            <!-- Explicação -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Outros jogadores próximos poderão encontrar você enquanto sua disponibilidade estiver ativa."
                android:textColor="#71717A"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />


            <!-- Aviso -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#17171F">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🟢 Disponível para jogadores"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVisibilityRemainingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Você pode ficar visível por até 1 dia."
                    android:textColor="#A1A1AA"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="A qualquer momento alguém da sua região poderá encontrar seu perfil e entrar em contato com você."
                    android:textColor="#71717A"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>


            <!-- Opções deixadas pelo usuário -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#17171F">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contato"
                    android:textColor="#71717A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVisibleContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="discord.com/users/..."
                    android:textColor="#A78BFA"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Raio de busca"
                    android:textColor="#71717A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVisibleDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5 km"
                    android:textColor="#A78BFA"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- Cancelar -->

            <Button
                android:id="@+id/btnCancelVisibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#27272A"
                android:text="Cancelar disponibilidade"
                android:textAllCaps="false"
                android:textColor="#F87171"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>