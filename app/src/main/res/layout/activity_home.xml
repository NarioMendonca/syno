<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B10">

    <!-- Conteúdo da Home -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo -->
            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNO"
                android:textColor="#8B5CF6"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Saudação -->
            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Olá, jogador! 👋"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Encontre alguém para jogar."
                android:textColor="#71717A"
                android:textSize="15sp" />

            <!-- Botão Agendar -->
            <Button
                android:id="@+id/btnScheduleMatch"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#8B5CF6"
                android:text="Agendar partida"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvUpcomingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Suas partidas"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/emptyMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp"
                android:background="#17171F"
                android:visibility="gone">

                <TextView
                    android:id="@+id/matchesDefaultMessageLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/matchesDefaultMessageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nenhuma partida agendada"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/matchesDefaultMessageDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Agende uma partida e encontre jogadores."
                    android:textColor="#71717A"
                    android:textSize="13sp" />

            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>
            <ProgressBar
                android:id="@+id/matchesProgressBar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:indeterminate="true"
                android:indeterminateTint="#8B5CF6"
                android:layout_gravity="center"/>


        </LinearLayout>
    </ScrollView>

    <!-- Navbar -->
    <include
        layout="@layout/bottom_navigation" />

</LinearLayout>